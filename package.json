{
    "private": true,
    "packageManager": "bun@1.4.2",
    "type": "module",
    "scripts": {
        "dev": "rm -rf public/build && vite",
        "dev:fast": "vite",
        "build": "rm -rf public/build public/hot && vite build",
        "browser": "echo \"const supportedBrowsers = $(browserslist-useragent-regexp --allowHigherVersions);\n\nexport { supportedBrowsers };\" > resources/ts/browser.ts",
        "all:fix": "bun run prettier:fix && bun run eslint:fix",
        "eslint": "eslint",
        "eslint:fix": "eslint --fix",
        "prettier": "prettier --check --no-error-on-unmatched-pattern resources/**/*.{css,scss,vue,js,cjs,ts,json,md} *.{css,scss,vue,js,cjs,ts,json,md}",
        "prettier:fix": "prettier --write --no-error-on-unmatched-pattern resources/**/*.{css,scss,vue,js,cjs,ts,json,md} *.{css,scss,vue,js,cjs,ts,json,md}",
        "test": "vitest run --reporter=verbose",
        "test:watch": "vitest --reporter=verbose --watch",
        "test:coverage": "vitest run --reporter=html --coverage",
        "test:coverage:watch": "vitest --reporter=html --coverage --watch",
        "test:browser": "vitest run --reporter=html --coverage --browser",
        "test:browser:watch": "vitest --reporter=html --coverage --browser --watch",
        "test:browser:debug": "vitest --reporter=html --coverage --browser --watch --debug",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@eslint/js": "^10.0.1",
        "@nuxt/icon": "^2.5.1",
        "@nuxt/ui": "^4.11.3",
        "@sentry/vue": "^11.4.0",
        "@tailwindcss/vite": "^4.3.3",
        "@unhead/vue": "^3.4.2",
        "@vitejs/plugin-vue": "^6.0.9",
        "animejs": "^4.5.0",
        "autoprefixer": "^10.6.1",
        "axios": "1.20.0",
        "concurrently": "^10.0.5",
        "laravel-echo": "^2.5.0",
        "laravel-vite-plugin": "^3.2.0",
        "lodash": "^4.18.1",
        "pinia": "^4.0.3",
        "postcss": "^8.5.29",
        "postcss-convert-values": "^9.0.7",
        "pusher-js": "8.6.0",
        "sass": "^1.105.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "vite": "^8.3.2",
        "vite-plugin-static-copy": "^4.1.1",
        "vue": "^3.5.43",
        "vue-clipboard3": "^2.0.0",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@nuxt/test-utils": "^4.3.3",
        "@tsconfig/recommended": "^1.0.13",
        "@types/node": "^26.6.4",
        "@vitest/coverage-istanbul": "^5.0.3",
        "@vitest/coverage-v8": "^5.0.3",
        "@vitest/ui": "5.0.3",
        "@vue/test-utils": "^2.5.1",
        "browserslist-useragent-regexp": "^4.1.4",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "jsdom": "~30.0.1",
        "prettier": "^3.9.9",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.1",
        "vitest": "^5.0.3",
        "vue-eslint-parser": "^10.4.1"
    },
    "overrides": {
        "vitest-environment-nuxt": "^1.0.1"
    }
}
